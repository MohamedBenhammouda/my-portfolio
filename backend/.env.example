# ─────────────────────────────────────────────────────────────
#  Portfolio Backend — Environment Variables
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────

# Port the Express server listens on (default: 3001)
PORT=3001

# Gmail address used to SEND emails (must have 2-FA enabled)
SMTP_USER=your-gmail@gmail.com

# Gmail App Password — generate at:
# https://myaccount.google.com/apppasswords
# (16 characters, no spaces)
SMTP_PASS=your-app-password-here

# Email address that receives the contact form submissions
RECIPIENT_EMAIL=ezz.bnhammouda@gmail.com

# Comma-separated list of allowed frontend origins (for CORS)
# Leave empty to allow all localhost origins during development
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Optional secret key to protect the GET /api/track stats endpoint
# If set, requests must include header: x-stats-key: <value>
# Leave empty to allow unauthenticated access (fine for local dev)
STATS_SECRET=
